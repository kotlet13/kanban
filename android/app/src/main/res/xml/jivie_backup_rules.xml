<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit user exports remain available through the OS picker. Automatic
     installation backup must not restore device-bound keys or bearer sessions. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
